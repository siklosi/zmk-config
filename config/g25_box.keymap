#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        race_layer {
            bindings = <
                &kp F13 &kp F14 &kp F15 &kp F16 &kp F17 &kp F18 &kp F19 &lt 1 F20
            >;

            sensor-bindings = <
                &inc_dec_kp F21 F22
                &inc_dec_kp F23 F24
                &inc_dec_kp F1 F2
            >;
        };

        system_layer {
            bindings = <
                &bt BT_NXT &bt BT_PRV &bt BT_CLR &kp C_PP &kp C_MUTE &to 0 &kp C_PREV &kp C_NEXT
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp C_NEXT C_PREV
                &inc_dec_kp PG_UP PG_DN
            >;
        };
    };
};
