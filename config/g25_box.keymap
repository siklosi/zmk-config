#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        race_layer {
            bindings = <
                &kp F13 &kp F14 &kp F15 &kp F16 &kp F17 &kp F18 &kp F19 &mo 1
            >;

            sensor-bindings = <
                &inc_dec_kp F20 F21
                &inc_dec_kp F22 F23
                &inc_dec_kp F24 F1
            >;
        };

        system_layer {
            bindings = <
                &bt BT_NXT &bt BT_PRV &bt BT_CLR &kp C_PP &kp C_MUTE &to 0 &kp C_PREV &kp C_NEXT
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp C_NEXT C_PREV
                &inc_dec_kp PG_UP PG_DN
            >;
        };
    };
};
